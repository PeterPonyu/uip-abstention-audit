<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.shortTitle }}</title>
  <meta name="description" content="{{ site.title }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/css/companion.css' | url }}">
</head>
<body>
  {% include "nav.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>{{ site.author }}. <a href="{{ site.orcid }}">ORCID</a>. <a href="{{ site.authorHome }}">Author</a>. <a href="{{ site.codeUrl }}">Code</a>. <a href="{{ site.dataDoi }}">Data</a>.</p>
  </footer>
</body>
</html>
